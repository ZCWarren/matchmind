{
  "name": "matchmind-promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "sync": "node scripts/sync-demo.mjs",
    "audio": "python3 scripts/generate_audio.py --music-only",
    "render": "npm run render:main && npm run render:teaser",
    "render:main": "remotion render src/index.ts MatchMindPromo out/promo.mp4 --codec=h264 --crf=19 --concurrency=2 --gl=angle-egl --browser-executable=/usr/bin/google-chrome",
    "render:teaser": "remotion render src/index.ts MatchMindTeaser out/teaser.mp4 --codec=h264 --crf=19 --concurrency=2 --gl=angle-egl --browser-executable=/usr/bin/google-chrome",
    "render:audio": "remotion render src/index.ts MatchMindPromoAudio out/promo-audio.wav --codec=wav --concurrency=2 --browser-executable=/usr/bin/google-chrome && remotion render src/index.ts MatchMindTeaserAudio out/teaser-audio.wav --codec=wav --concurrency=2 --browser-executable=/usr/bin/google-chrome",
    "mux": "bash scripts/mux-audio.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.538",
    "@remotion/motion-blur": "^4.0.538",
    "@remotion/three": "^4.0.538",
    "@remotion/transitions": "^4.0.538",
    "postprocessing": "^6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
